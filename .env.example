# ============================================================
# GLEH LAUNDRY - ENVIRONMENT CONFIGURATION
# ============================================================

# Server-side n8n Webhook URL for Gleh AI Assistant (/api/chat proxy)
# Replace with your live n8n Webhook Production URL before enabling the chatbot.
N8N_WEBHOOK_URL="https://YOUR-N8N-INSTANCE.app.n8n.cloud/webhook/gleh-chat"

# Optional server-side webhook authentication (kept strictly on the server)
# Example: N8N_WEBHOOK_AUTH_HEADER="X-Webhook-Token"
N8N_WEBHOOK_AUTH_HEADER=""
N8N_WEBHOOK_AUTH_TOKEN=""

# Optional fallback ONLY for static-only hosting (when /api/chat backend is unavailable).
# Must be a public CORS-enabled n8n webhook URL without embedded secrets.
VITE_N8N_WEBHOOK_URL=""

# Application runtime URL (injected automatically in AI Studio / Cloud Run)
APP_URL="MY_APP_URL"
